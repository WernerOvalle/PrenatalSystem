{
  "name": "mediagenda-demo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --permission --allow-fs-read=* --allow-fs-write=* --allow-child-process --allow-worker --allow-addons node_modules/next/dist/bin/next dev",
    "build": "next build",
    "lint": "node --permission --allow-fs-read=* --allow-child-process --allow-addons node_modules/eslint/bin/eslint.js .",
    "preview": "node --permission --allow-fs-read=./out --allow-fs-read=./serve.mjs serve.mjs",
    "deploy": "pnpm build && pnpm dlx @azure/static-web-apps-cli@2.0.10 deploy ./out --env production --no-use-keychain"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
